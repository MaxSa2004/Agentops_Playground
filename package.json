{
  "name": "agentops-playground",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @agentops/web",
    "dev:api": "npm run dev --workspace @agentops/api",
    "build": "npm run build --workspace @agentops/api && npm run build --workspace @agentops/web",
    "preview": "npm run preview --workspace @agentops/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^2.1.5"
  }
}
